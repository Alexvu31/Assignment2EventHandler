@model Assignment1EventHandler.Models.Event

<h2>Manage Attendees</h2>

<h4>Event: @Model.Title</h4>

<a asp-action="CreateAttendee"
   asp-route-eventId="@Model.Id"
   class="btn btn-success mb-3">
    Add Attendee
</a>

<a asp-action="Details"
   asp-route-eventId="@Model.Id"
   class="btn btn-secondary mb-3">
    Back to Event
</a>

@if (Model.Attendees.Any())
{
    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var attendee in Model.Attendees)
            {
                <tr>
                    <td>@attendee.Name</td>
                    <td>@attendee.Email</td>

                    <td>
                        <a asp-action="EditAttendee"
                           asp-route-eventId="@Model.Id"
                           asp-route-id="@attendee.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <form asp-action="DeleteAttendee"
                              asp-route-eventId="@Model.Id"
                              asp-route-id="@attendee.Id"
                              method="post"
                              style="display:inline;">

                            <button type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Delete this attendee?');">
                                Delete
                            </button>

                        </form>
                    </td>
                </tr>
            }
        </tbody>

    </table>
}
else
{
    <p>No attendees registered for this event.</p>
}
