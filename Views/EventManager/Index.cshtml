@model IEnumerable<Assignment1EventHandler.Models.Event>

@{
    ViewData["Title"] = "Event Manager";
}

<h2>Event Manager</h2>

<p>Manage your events and attendees.</p>

<a asp-action="Create" class="btn btn-success mb-3">
    Create New Event
</a>

<table class="table table-striped table-bordered">

    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th>Attendees</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var ev in Model)
        {
            <tr>
                <td>@ev.Title</td>
                <td>@ev.Date.ToString("g")</td>
                <td>@ev.Location</td>
                <td>@ev.Attendees.Count</td>

                <td>
                    <a asp-action="Details"
                       asp-route-eventId="@ev.Id"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-eventId="@ev.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-eventId="@ev.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>

                    <a asp-action="ManageAttendees"
                       asp-route-eventId="@ev.Id"
                       class="btn btn-primary btn-sm">
                        Attendees
                    </a>
                </td>
            </tr>
        }
    </tbody>

</table>
