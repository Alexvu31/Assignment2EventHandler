@model Assignment1EventHandler.Models.Event
@using System.Security.Claims
@{
    ViewData["Title"] = "Event Details";
    var isOrganizer = User.IsInRole("Organizer");
    var isRegistered = (bool?)ViewBag.IsRegistered ?? false;
    var attendeeCount = (int?)ViewBag.AttendeeCount ?? Model.Attendees.Count;
}

<h2>Event Details</h2>
<div class="card mb-4">
    <div class="card-body">
        <h3>@Model.Title</h3>
        @if (!string.IsNullOrEmpty(Model.BannerUrl))
        {
            <div class="mb-4">
                <img src="@Model.BannerUrl" alt="@Model.Title Banner" class="img-fluid rounded" style="width:100%;max-height:400px;object-fit:cover;" />
            </div>
        }
        else
        {
            <div class="alert alert-info">No banner image has been uploaded for this event.</div>
        }
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Date:</strong> @Model.Date.ToString("f")</p>
        <p><strong>Location:</strong> @Model.Location</p>

        @if (isOrganizer)
        {
            <a asp-action="Edit" asp-route-eventId="@Model.Id" class="btn btn-warning">Edit Event</a>
            <a asp-action="ManageAttendees" asp-route-eventId="@Model.Id" class="btn btn-primary">Manage Attendees</a>
        }
        else if (isRegistered)
        {
            <form asp-action="Unregister" asp-route-eventId="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-danger">Unregister</button>
            </form>
        }
        else
        {
            <form asp-action="Register" asp-route-eventId="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-success">Register for this event</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>

@if (TempData["RegistrationMessage"] != null)
{
    <div class="alert alert-info">@TempData["RegistrationMessage"]</div>
}

<div id="organizerNotification" class="alert alert-success" role="alert" style="display:none;"></div>
<h3>Attendees (<span id="attendeeCount">@attendeeCount</span>)</h3>
<table class="table table-bordered" id="attendeeTable">
    <thead><tr><th>Name</th><th>Email</th></tr></thead>
    <tbody id="attendeeList">
        @foreach (var attendee in Model.Attendees)
        {
            <tr data-attendee-id="@attendee.Id"><td>@attendee.Name</td><td>@attendee.Email</td></tr>
        }
    </tbody>
</table>
<p id="emptyAttendees" style="@(Model.Attendees.Any() ? "display:none;" : "")">No attendees registered yet.</p>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        (() => {
            const eventId = @Model.Id;
            const list = document.getElementById('attendeeList');
            const count = document.getElementById('attendeeCount');
            const empty = document.getElementById('emptyAttendees');
            const notification = document.getElementById('organizerNotification');

            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/eventHub')
                .withAutomaticReconnect()
                .build();

            connection.on('AttendeeUpdated', data => {
                count.textContent = data.attendeeCount;
                if (!list.querySelector(`[data-attendee-id="${CSS.escape(data.attendeeId)}"]`)) {
                    const row = document.createElement('tr');
                    row.dataset.attendeeId = data.attendeeId;
                    const name = document.createElement('td');
                    const email = document.createElement('td');
                    name.textContent = data.attendeeName;
                    email.textContent = data.attendeeEmail;
                    row.append(name, email);
                    list.appendChild(row);
                }
                if (empty) empty.style.display = 'none';
            });

            connection.on('AttendeeRemoved', data => {
                count.textContent = data.attendeeCount;
                list.querySelector(`[data-attendee-id="${CSS.escape(data.attendeeId)}"]`)?.remove();
                if (data.attendeeCount === 0 && empty) empty.style.display = 'block';
            });

            @if (isOrganizer)
            {
                <text>
                connection.on('OrganizerNotification', message => {
                    notification.textContent = message;
                    notification.style.display = 'block';
                });
                </text>
            }

            async function start() {
                try {
                    await connection.start();
                    await connection.invoke('JoinEventGroup', eventId);
                } catch (err) {
                    console.error('SignalR connection failed:', err);
                    setTimeout(start, 5000);
                }
            }
            start();
        })();
    </script>
}
